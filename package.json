{
  "name": "jonzone-toy-zone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:tokens": "style-dictionary build --config style-dictionary.config.mjs",
    "dev": "concurrently \"style-dictionary build --watch --config style-dictionary.config.mjs\" \"vite\"",
    "build": "tsc -b && vite build",
    "prebuild": "npm run build:tokens",
    "lint": "eslint .",
    "verify:csp": "node scripts/verify-csp-connect-src.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "db:link": "npx supabase link",
    "db:push": "npx supabase db push",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.8.0",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.3",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-react-x": "^5.9.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "msw": "^2.13.2",
    "prettier": "^3.8.1",
    "storybook": "^10.4.0",
    "style-dictionary": "^5.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.5",
    "vitest": "^4.1.3"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
